# Copy to .env locally; do not commit it. Compose can read it using --env-file .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agent_digest
DIGEST_OFFLINE=false
DIGEST_FEEDS=https://github.blog/ai-and-ml/feed/
DIGEST_PROFILE=classpath:prompts/profile-v1.txt
DIGEST_WINDOW_HOURS=24
DIGEST_MAX_ITEMS=5
DIGEST_MAX_CANDIDATES=30
DIGEST_TIMEOUT_SECONDS=30
DIGEST_MAX_OUTPUT_TOKENS=2048
DIGEST_TELEGRAM_RETRIES=2
