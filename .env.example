# Copy to .env locally. Never commit populated credentials.
# Compose: docker compose --env-file .env -f docker/compose.yaml ...
# Java does NOT automatically load .env; use environment variables or a local external YAML.
DIGEST_OFFLINE=false
DIGEST_RECOVERY_ONLY=false
DIGEST_PROFILE=Senior Java Developer; Java, Spring Boot, Maven, MongoDB, PostgreSQL, Kafka; personal products and Telegram bots; Claude, Codex, GitHub Copilot, BMAD; agent workflows, harness engineering, context management, architecture, testing, independent verification and operating costs
DIGEST_WINDOW=30d
DIGEST_MAX_ITEMS=2
DIGEST_MAX_CANDIDATES=60
DIGEST_EXCERPT_CHARS=1500
DIGEST_MAX_CONTEXT_CHARS=40000
DIGEST_TIMEOUT=30s
DIGEST_MAX_RESPONSE_BYTES=2000000
DIGEST_FEEDS=https://github.blog/changelog/feed/,https://github.blog/ai-and-ml/feed/,https://github.blog/engineering/feed/,https://openai.com/news/rss.xml,https://simonwillison.net/atom/entries/,https://huggingface.co/blog/feed.xml,https://blog.google/innovation-and-ai/technology/ai/rss/,https://research.google/blog/rss/,https://www.microsoft.com/en-us/research/feed/,https://devblogs.microsoft.com/agent-framework/feed/,https://blogs.nvidia.com/feed/,https://aws.amazon.com/blogs/machine-learning/feed/,https://blog.jetbrains.com/ai/feed/,https://blog.jetbrains.com/idea/feed/,https://spring.io/blog.atom,https://inside.java/feed.xml,https://www.docker.com/feed/,https://feed.infoq.com/,https://stackoverflow.blog/feed/,https://ollama.com/blog/rss.xml
MONGODB_URI=mongodb://localhost:27019/?retryWrites=true&w=majority
MONGODB_DATABASE=agent_digest
MONGODB_PORT=27019
ANTHROPIC_API_KEY=
# Recommended: claude-opus-5-5 (best selection quality); claude-sonnet-5-5 is a cheaper alternative.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_ENDPOINT=https://api.anthropic.com/v1/messages
# Thinking shares this budget with the JSON answer; keep it high (256вЂ“16000).
CLAUDE_MAX_TOKENS=16000
CLAUDE_RETRIES=1
# low|medium|high|xhigh|max; leave empty to omit for models without effort support.
CLAUDE_EFFORT=low
CLAUDE_TIMEOUT=120s
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENDPOINT=https://api.telegram.org
TELEGRAM_RETRIES=1
TELEGRAM_MAX_RETRY_AFTER=30s
TELEGRAM_INTERVAL=1s
IMAGE_NAME=agent-digest
IMAGE_TAG=local
